.{
    // -------------------------
    // Server settings
    // -------------------------
    // IP address zcached will bind to
    .address = "127.0.0.1",

    // Maximum number of concurrent clients per accept task
    .max_clients = 1024,

    // Number of concurrent accept tasks
    .workers = 4,

    // TCP port zcached will listen on
    .port = 7556,

    .network = .{
        // 0 disables each timeout. Idle also limits the TLS handshake.
        .idle_timeout_ms = 0,
        // Time to finish receiving a frame after its first bytes arrive.
        .request_timeout_ms = 0,
        // Process at most this many commands before flushing; 0 disables the count boundary.
        .max_pipeline_commands = 256,
        // Flush pipelined responses at this threshold; 0 disables size-based batching.
        .max_pending_response_bytes = 1048576, // 1 MiB
        // Reject one response at this encoded size; 0 disables the per-response limit.
        .max_response_bytes = 8388608, // 8 MiB
    },

    // -------------------------
    // Memory and request limits
    // -------------------------
    .memory = .{
        .shard_count = 16,
        .default_capacity = 64,
        // Global limit across shards in bytes; 0 = unlimited unless legacy max_memory is set.
        .limit = 0,
    },

    // Default per-client buffer size in bytes
    .client_buffer = 4096,

    // Log request and response payloads
    .log_network_payloads = true,

    // Minimum operational severity: .debug, .info, .warning, .@"error".
    .log = .{ .level = .debug },

    // Maximum aggregate unread request bytes per connection; 0 disables the limit.
    .max_request_size = 10485760, // 10 MB

    // -------------------------
    // TLS configuration
    // -------------------------
    .tls = .{
        .enabled = true,

        .cert_path = "./src/tests/e2e/certificate.pem",
        .key_path = "./src/tests/e2e/private_key.pem",

        // Optional CA certificate path
        .ca_path = null,

        // Verification mode for client certificates
        // Options: .none, .peer, .fail_if_no_peer_cert, .client_once
        .verify_mode = .none,
    },

    // -------------------------
    // AOF (Append Only File) settings
    // -------------------------
    .aof = .{
        // Strategy for flushing AOF to disk
        // Options: .auto, .always, .everysec, .no
        .flush_strategy = .everysec,

        // Path to the AOF file
        .path = "./data/appendonly.aof",

        // Options below are only relevant for .flush_strategy = .auto
        // Trigger background rewrite when AOF grows by this percentage
        // relative to the size after the last rewrite
        .rewrite_percentage = 100,

        // Minimum AOF size before a rewrite can be triggered (64 MB)
        .rewrite_min_size = 67108864,
    },

    .snapshot = .{
        .path = "./persist",
        // 0 disables scheduled saves; manual SAVE is still available.
        .interval_secs = 0,
        // 0 keeps all snapshots.
        .keep_last = 0,
    },

    // -------------------------
    // Client whitelist
    // -------------------------
    .whitelist = .{
        "127.0.0.1",
        "127.0.0.2",
        "127.0.0.3",
        "127.0.0.4",
    },
}
